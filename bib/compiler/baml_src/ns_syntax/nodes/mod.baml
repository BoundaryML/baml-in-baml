    let n: ParenPattern => n.span,
    let n: ParenType => n.span,
    let n: PathExpr => n.span,
    let n: PathType => n.span,
    let n: PromptField => n.span,
    let n: QualifiedPath => n.span,
    let n: RemovedItem => n.span,
