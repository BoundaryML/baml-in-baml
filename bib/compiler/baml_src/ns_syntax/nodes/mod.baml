// Every node kind (the Rust `define_tree!` node list).
type AnyNode = Arg | ArgList | ArrayLiteral | ArrayPattern | ArrayType | AssignStmt | AssocTypeBinding | AssocTypeDecl | AssocTypeDef | AttrArgs | Attribute | AwaitExpr | BacktickString | BinaryExpr | BindingPattern | Block | BlockAttr | Bogus | BreakExpr | CForHeader | CallExpr | CatchArm | CatchClause | CatchExpr | ClassDef | ClientField | ClientValueDef | ContinueExpr | DefaultValue | DeferStmt | DestructurePattern | Directive | DocLine | DottedName | EmptyStmt | EnumDef | EnumVariant | EnvAccessExpr | ExprStmt | Field | FieldAccessExpr | FieldPattern | ForInHeader | ForStmt | FunctionDef | FunctionType | FunctionTypeParam | GenericApplyExpr | GenericArgs | GenericParam | GenericParamBounds | GenericParamList | HeaderLine | HeaderStmt | IfExpr | IfLetExpr | ImplementsBlock | ImplementsFor | IndexExpr | InterfaceDef | InterfaceFieldLink | IsExpr | JinjaArg | LambdaExpr | LetItem | LetStmt | LiteralExpr | LiteralType | LlmBody | MapEntry | MapLiteral | MatchArm | MatchExpr | MatchParen | MethodSig | Name | ObjectField | ObjectLiteral | OptionalCallExpr | OptionalFieldAccessExpr | OptionalIndexExpr | OptionalType | Param | ParamList | ParenExpr | ParenForInHeader | ParenPattern | ParenType | PathExpr | PathType | PromptField | QualifiedPath | RemovedItem | RequiresClause | RestPattern | ReturnExpr | ReturnType | SourceFile | SpawnExpr | SpecExpr | SpreadElement | StringLit | TaggedTemplateExpr | TemplateElif | TemplateElse | TemplateEndTag | TemplateFor | TemplateForOpen | TemplateIf | TemplateIfOpen | TemplateInterp | TestDef | ThrowExpr | ThrowsClause | ToolsField | TupleExpr | TupleFieldExpr | TuplePattern | TupleType | TypeAliasDef | TypeArgs | TypeAscription | TypeBindingStmt | TypePattern | UnaryExpr | UnionPattern | UnionType | UpcastExpr | WhileLetStmt | WhileStmt | WildcardPattern | WithClause

// The token span of any node. (A union cannot read a field its members
// share, so this is one exhaustive match.)
function node_span(node: AnyNode) -> TokenRange throws never {
  match (node) {
    let n: Arg => n.span,
    let n: ArgList => n.span,
    let n: ArrayLiteral => n.span,
    let n: ArrayPattern => n.span,
    let n: ArrayType => n.span,
    let n: AssignStmt => n.span,
    let n: AssocTypeBinding => n.span,
    let n: AssocTypeDecl => n.span,
    let n: AssocTypeDef => n.span,
    let n: AttrArgs => n.span,
    let n: Attribute => n.span,
    let n: AwaitExpr => n.span,
    let n: BacktickString => n.span,
    let n: BinaryExpr => n.span,
    let n: BindingPattern => n.span,
    let n: Block => n.span,
    let n: BlockAttr => n.span,
    let n: Bogus => n.span,
    let n: BreakExpr => n.span,
    let n: CForHeader => n.span,
    let n: CallExpr => n.span,
    let n: CatchArm => n.span,
    let n: CatchClause => n.span,
    let n: CatchExpr => n.span,
    let n: ClassDef => n.span,
    let n: ClientField => n.span,
    let n: ClientValueDef => n.span,
    let n: ContinueExpr => n.span,
    let n: DefaultValue => n.span,
    let n: DeferStmt => n.span,
    let n: DestructurePattern => n.span,
    let n: Directive => n.span,
    let n: DocLine => n.span,
    let n: DottedName => n.span,
    let n: EmptyStmt => n.span,
    let n: EnumDef => n.span,
    let n: EnumVariant => n.span,
    let n: EnvAccessExpr => n.span,
    let n: ExprStmt => n.span,
    let n: Field => n.span,
    let n: FieldAccessExpr => n.span,
    let n: FieldPattern => n.span,
    let n: ForInHeader => n.span,
    let n: ForStmt => n.span,
    let n: FunctionDef => n.span,
    let n: FunctionType => n.span,
    let n: FunctionTypeParam => n.span,
    let n: GenericApplyExpr => n.span,
