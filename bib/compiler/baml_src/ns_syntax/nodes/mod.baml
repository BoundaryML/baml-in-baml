    let n: TypeBindingStmt => n.span,
    let n: TypePattern => n.span,
    let n: UnaryExpr => n.span,
    let n: UnionPattern => n.span,
    let n: UnionType => n.span,
    let n: UpcastExpr => n.span,
    let n: WhileLetStmt => n.span,
    let n: WhileStmt => n.span,
