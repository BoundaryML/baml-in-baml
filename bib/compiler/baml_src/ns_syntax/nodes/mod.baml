    let n: IndexExpr => n.span,
    let n: InterfaceDef => n.span,
    let n: InterfaceFieldLink => n.span,
    let n: IsExpr => n.span,
    let n: JinjaArg => n.span,
    let n: LambdaExpr => n.span,
    let n: LetItem => n.span,
    let n: LetStmt => n.span,
    let n: LiteralExpr => n.span,
    let n: LiteralType => n.span,
    let n: LlmBody => n.span,
    let n: MapEntry => n.span,
    let n: MapLiteral => n.span,
    let n: MatchArm => n.span,
    let n: MatchExpr => n.span,
    let n: MatchParen => n.span,
    let n: MethodSig => n.span,
    let n: Name => n.span,
